@{
    ViewData["Title"] = "Create";
}

@model CreatedDepartmentDTO

<h1>Create New Department</h1>



<form action="/Department/Create" method="post">
    <div asp-validation-summary="ModelOnly" class=""></div>

    <div class="form-floating mb-3">
        <input  class="form-control" asp-for="Code" >
        <label asp-for="Code"></label>
                <span asp-validation-for="Code" class="text-danger alert-info"></span>

    </div>


    <div class="form-floating mb-3">
        <input  class="form-control" asp-for="Name" >
        <label asp-for="Name"></label>
        <span asp-validation-for="Name" class="text-danger alert-info"></span>

    </div>

    <div class="form-floating mb-3">
        <input type="date" class="form-control" asp-for="CreationDate" >
        <label asp-for="CreationDate"></label>
        <span asp-validation-for="CreationDate" class="text-danger alert-info"></span>

    </div>
      <input type="submit" class="btn btn-outline-primary">
    <a asp-controller="Department" asp-action="Create" class="btn btn-success">
        Back To List
    </a>
</form>
