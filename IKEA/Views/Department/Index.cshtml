@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<DepartmentToReturnDTO>

<h1>
    All Departments
</h1>

<a class="btn btn-outline-primary"  asp-controller="Department" asp-action="Create">
    Create New Department
</a>

@if(Model.Count()>0)
{
    <table class="table table-striped table-hover mt-4 text-center">
        <thead >
            <tr>

                <th>@Html.DisplayNameFor(D=>D.Code)</th>
                <th>@Html.DisplayNameFor(D=>D.Name)</th>
                <th>@Html.DisplayNameFor(D=>D.CreationDate)</th>
                @* <th>@Html.DisplayNameFor(D=>D.Description)</th> *@
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>

            </tr>
        </thead>

        <tbody >
            @foreach (var department in Model)
            {
               <tr>

             <td>@department.Code</td>   
             <td>@department.Name</td>   
             <td>@department.CreationDate</td>   
             <td>
                <a class="btn btn-outline-warning" asp-controller="Department" asp-action="Details"
                asp-route-Id ="@department.Id">
                    <i class="fa-solid fa-info"></i>
                Details</a>
             </td>
            <td>
                <a class="btn btn-success"
                   asp-controller="Department"
                   asp-action="Edit"
                   asp-route-Id="@department.Id">
                    <i class="fa-solid fa-pen-to-square"></i>
                    Update
                </a>
            </td>

            <td>

                        <!-- Button trigger modal -->
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" 
                        data-bs-target="#deleteModal" onclick="showModal(@department.Id,'@department.Name')">
                            <i class="fa-solid fa-eraser"></i>
                        </button>
            </td>

               </tr>
            }
        </tbody>
    </table>

    <!-- Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">DeleteDepartment</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are You Sure To Delete This Department :
                    <span id="nameOfDepartment"></span>
                </div>
                <div class="modal-footer">
                    <form id="deletedForm" method="post">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Delete</button>
                    </form>

                </div>
            </div>
        </div>
    </div>


}
else{
    <div class="alert alert-info mt-3">
       <h3>
           Sorry There Is No Departments :(
       </h3>
    </div>
}


<script defer>

   var modal = document.getElementById("deleteModal");
     function showModal(id,name)
    {
        console.log(id,name);
         document.getElementById("nameOfDepartment").innerText = name;
          let form = document.getElementById("deletedForm");
         form.setAttribute("action", `/Department/Delete/${id}`);
    }
</script>

